# Keep real values out of source control and frontend code.
OPENAI_API_KEY=your_server_side_key
# local is the default and works without API credits. Use openai only to
# rebuild an index with OpenAI embeddings; indexes never mix models.
ARES_EMBEDDING_BACKEND=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Local document-answer generation (no API key required). Ollama must already
# be installed, running, and have this exact model pulled; ARES never pulls it.
ARES_LLM_PROVIDER=ollama
ARES_LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
ARES_LLM_CONTEXT_CHARS=24000
ARES_LLM_MAX_OUTPUT_TOKENS=700
ARES_PORT=8080
ARES_RAG_CHUNK_SIZE=1200
ARES_RAG_CHUNK_OVERLAP=180
ARES_RAG_TOP_K=5
ARES_RAG_RELEVANCE_THRESHOLD=0.38
ARES_RAG_EMBED_BATCH_SIZE=64
ARES_RAG_PROGRESS_EVERY=25
ARES_RAG_REQUESTS_PER_MINUTE=12
ARES_RAG_MAX_UPLOAD_MB=100
ARES_RAG_OCR_ENABLED=false
ARES_RAG_OCR_MAX_PAGES=100
ARES_RAG_OCR_DPI=180
ARES_RAG_OCR_LANG=eng
